<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for Wallboxd, packaged via Desktop Bridge (a classic Win32
  exe running with package identity — EntryPoint="Windows.FullTrustApplication"
  plus the rescap:runFullTrust capability below is what makes that legal).

  Package identity is not cosmetic here: Windows' lock screen personalization
  API (UserProfilePersonalizationSettings.TrySetLockScreenImageAsync) silently
  declines for any process with no package identity — confirmed by testing
  the unpackaged build directly (see AGENTS.md's "Lock screen" section).
  Package identity is the actual fix for that; this manifest is what supplies
  it.

  Identity/Publisher/PublisherDisplayName values below are assigned by the
  Microsoft Store (Partner Center) for this app and must match exactly —
  don't regenerate or "clean up" them.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="abusayed.dev.Wallboxd"
    Publisher="CN=8EA73F0A-0DC1-449F-A896-493A34649C49"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Wallboxd</DisplayName>
    <PublisherDisplayName>abusayed.dev</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Wallboxd" Executable="Wallboxd.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Wallboxd"
        Description="Sets your Windows desktop wallpaper and lock screen to a Letterboxd poster wall."
        BackgroundColor="#1B2A41"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- TaskId must match autostart.rs's TASK_ID exactly, since that's
             how StartupTask::GetAsync finds this task. Registry Run keys and the
             Startup folder are both unsupported for packaged apps; this
             extension plus the StartupTask WinRT API is the documented
             replacement, and is what shows up in Task Manager's Startup tab. -->
        <desktop:Extension Category="windows.startupTask" Executable="Wallboxd.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="WallboxdStartupTask" Enabled="true" DisplayName="Wallboxd" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
