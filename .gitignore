# Generated by Cargo
/target/
/dist/

# MSIX packaging output and local test-signing material — never commit a
# private key; the Store re-signs with its own certificate on submission,
# these are only for local sideload testing (see packaging/README.md)
/packaging/build/
*.msix
*.msixupload
*.pfx
*.cer

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Editor workspaces
.vscode/
.idea/
.claude/

# Agent/AI tools
.agents/
.opencode/
skills-lock.json
